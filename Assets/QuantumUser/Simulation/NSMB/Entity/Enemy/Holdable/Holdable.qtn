component Holdable {
	bool HoldAboveHead;

	[ExcludeFromPrototype] EntityRef Holder;
	[ExcludeFromPrototype] EntityRef PreviousHolder;
	[ExcludeFromPrototype] PlayerRef LastActualHolder;

	[ExcludeFromPrototype] byte IgnoreOwnerFrames;
}

signal OnThrowHoldable(EntityRef entity, EntityRef mario, bool crouching, bool dropped);